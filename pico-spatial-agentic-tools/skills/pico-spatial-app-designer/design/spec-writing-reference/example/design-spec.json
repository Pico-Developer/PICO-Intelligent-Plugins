  "dataCases": {
    "books": [
      {
        "id": "slow",
        "title": "The Unhurried Days",
        "author": "Lin Jian",
        "tag": "Life essays · about 2 hours",
        "summary": "Find your own rhythm in everyday moments.",
        "description": "A collection of short essays about walking, cooking, and solitude. Through ordinary details, the author explores how to make room for yourself. Ideal for a few pages on a weekend afternoon.",
        "excerpt": "That morning, I did not rush outside. Window light moved slowly across the table, and yesterday's unfinished book still waited on the same page.",
        "color": "#537c70",
        "coverAssetId": "slow-cover",
        "authorAndTag": "Lin Jian · Life essays · about 2 hours"
      },
      {
        "id": "city",
        "title": "Another Side of the City",
        "author": "Zhou Yuan",
        "tag": "Urban observations · about 3 hours",
        "summary": "Rediscover a familiar city along its streets and alleys.",
        "description": "From secondhand bookshops and morning markets to riverside paths and late-night stores, this book records overlooked city routines and the people within them.",
        "excerpt": "Past the familiar intersection and down a narrow alley, I heard the city waking for the first time.",
        "color": "#a57253",
        "coverAssetId": "city-cover",
        "authorAndTag": "Zhou Yuan · Urban observations · about 3 hours"
      },
      {
        "id": "stars",
        "title": "Letters to the Night Sky",
        "author": "Xu Xing",
        "tag": "Nature reading · about 2.5 hours",
        "summary": "Experience nature at scale through starlight and seasons.",
        "description": "Beginning with the first visible star, follow seasonal changes across the night sky. There are no complex formulas, only observations and curiosity that can start at your window.",
        "excerpt": "After the lights went out, the night did not darken at once. As my eyes adjusted, distant stars appeared one after another.",
        "color": "#586584",
        "coverAssetId": "stars-cover",
        "authorAndTag": "Xu Xing · Nature reading · about 2.5 hours"
      }
    ]
