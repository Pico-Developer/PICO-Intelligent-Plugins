{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|exec_command|shell_command",
        "hooks": [
          {
            "type": "command",
            "command": "pico-cli workflow capture-context traex --integration pico-spatial-agentic-tools",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
