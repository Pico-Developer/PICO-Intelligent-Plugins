{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^(Skill|Read|DeferExecuteTool)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CODEBUDDY_PLUGIN_ROOT}/hooks/ingest.mjs\" pico-general-agentic-tools",
            "timeout": 65
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "^DeferExecuteTool$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CODEBUDDY_PLUGIN_ROOT}/hooks/ingest.mjs\" pico-general-agentic-tools",
            "timeout": 65
          }
        ]
      }
    ]
  }
}
