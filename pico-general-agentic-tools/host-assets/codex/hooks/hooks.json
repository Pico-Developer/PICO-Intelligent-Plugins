{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/host-assets/codex/hooks/ingest.mjs\"",
            "commandWindows": "node \"${PLUGIN_ROOT}\\host-assets\\codex\\hooks\\ingest.mjs\"",
            "timeout": 65
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(?:Bash|exec_command|shell_command|run_terminal_command|(?:mcp__(?:pico-spatial-editor|pico_spatial_editor)__)?(?:start_editor_workflow|start_3d_generation_workflow))$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/host-assets/codex/hooks/capture-context.mjs\" codex",
            "commandWindows": "node \"${PLUGIN_ROOT}\\host-assets\\codex\\hooks\\capture-context.mjs\" codex",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^mcp__(?:(?:pico[-_](?:dev[-_]knowledge|spatial[-_]editor))|unity[-_]mcp)__",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/host-assets/codex/hooks/ingest.mjs\"",
            "commandWindows": "node \"${PLUGIN_ROOT}\\host-assets\\codex\\hooks\\ingest.mjs\"",
            "timeout": 65
          }
        ]
