{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/host-assets/traecli/hooks/ingest.mjs\"",
            "commandWindows": "node \"${PLUGIN_ROOT}\\host-assets\\traecli\\hooks\\ingest.mjs\"",
            "timeout": 65
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/host-assets/traecli/hooks/ingest.mjs\"",
            "commandWindows": "node \"${PLUGIN_ROOT}\\host-assets\\traecli\\hooks\\ingest.mjs\"",
            "timeout": 65
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/host-assets/traecli/hooks/ingest.mjs\"",
            "commandWindows": "node \"${PLUGIN_ROOT}\\host-assets\\traecli\\hooks\\ingest.mjs\"",
            "timeout": 65
          }
        ]
      }
    ]
  }
}
